APP_NAME=AI Job Analyzer
APP_VERSION=0.3.0
DEBUG=true

# --- AI provider -------------------------------------------------------
# AI_PROVIDER=none   -> keyword-логика без AI (по умолчанию, без ключей)
# AI_PROVIDER=gemini -> реальный AI-анализ через Google Gemini API
# Ключ получить бесплатно: https://aistudio.google.com/apikey
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# Ограничения на вход
MIN_VACANCY_LENGTH=10
MAX_VACANCY_LENGTH=8000
MAX_RESUME_SIZE_MB=5

# --- PostgreSQL ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_job_analyzer

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- Celery ------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT-авторизация -----------------------------------------------------------
# ОБЯЗАТЕЛЬНО смените в проде на длинную случайную строку, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=*
